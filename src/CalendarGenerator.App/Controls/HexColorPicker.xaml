<UserControl x:Class="CalendarGenerator.App.Controls.HexColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120">
    <Grid>
        <Button x:Name="SwatchButton"
                Click="SwatchButton_Click"
                Padding="4"
                HorizontalContentAlignment="Stretch"
                Cursor="Hand"
                Background="#FFFCF8"
                BorderBrush="#D0C6B8"
                BorderThickness="1">
            <DockPanel>
                <Border x:Name="SwatchPreview"
                        DockPanel.Dock="Left"
                        Width="28" Height="22"
                        CornerRadius="3"
                        BorderBrush="#999"
                        BorderThickness="1"
                        Margin="0,0,8,0" />
                <TextBlock x:Name="HexLabel"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#333" />
            </DockPanel>
        </Button>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#FFFCF8"
                    BorderBrush="#C9B29A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Width="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.28" Color="#000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Színválasztó" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <!-- Saturation / Value field -->
                    <Grid x:Name="SvField"
                          Height="150"
                          Margin="0,0,0,8"
                          ClipToBounds="True"
                          MouseLeftButtonDown="SvField_MouseLeftButtonDown"
                          MouseMove="SvField_MouseMove"
                          MouseLeftButtonUp="SvField_MouseLeftButtonUp"
                          SizeChanged="SvField_SizeChanged">
                        <Border x:Name="HueBase" CornerRadius="4" />
                        <Border CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvCursor"
                                     Width="12" Height="12"
                                     Stroke="White" StrokeThickness="2"
                                     Fill="#00000000">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <!-- Hue slider -->
                    <Border x:Name="HueBar"
                            Height="16"
                            CornerRadius="3"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            SizeChanged="HueBar_SizeChanged"
                            MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                            MouseMove="HueBar_MouseMove"
                            MouseLeftButtonUp="HueBar_MouseLeftButtonUp">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                <GradientStop Color="#FF00FF00" Offset="0.33" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.67" />
                                <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas>
                            <Border x:Name="HueCursor"
                                    Width="4" Height="18"
                                    Background="White"
                                    BorderBrush="#333"
                                    BorderThickness="1"
                                    Canvas.Top="-1"
                                    IsHitTestVisible="False" />
                        </Canvas>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ResultSwatch"
                                Width="36" Height="28"
                                CornerRadius="4"
                                BorderBrush="#999"
                                BorderThickness="1"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="HexBox"
                                 Grid.Column="1"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 LostFocus="HexBox_LostFocus"
                                 KeyDown="HexBox_KeyDown" />
                        <TextBlock Grid.Column="2" Text="R" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="11" />
                        <TextBox x:Name="RBox" Grid.Column="3" LostFocus="RgbBox_LostFocus" KeyDown="RgbBox_KeyDown" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock />
                        <TextBlock Grid.Column="1" Text="G" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11" />
                        <TextBox x:Name="GBox" Grid.Column="2" LostFocus="RgbBox_LostFocus" KeyDown="RgbBox_KeyDown" />
                        <TextBlock Grid.Column="3" Text="B" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="11" />
                        <TextBox x:Name="BBox" Grid.Column="4" LostFocus="RgbBox_LostFocus" KeyDown="RgbBox_KeyDown" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Kész" Width="72" Padding="8,4" Click="Close_Click" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
