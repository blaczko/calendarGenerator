<UserControl x:Class="CalendarGenerator.App.Controls.PhotoCollageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F2EA"
             ClipToBounds="True">
    <Grid>
        <Border x:Name="Hint" Background="#22FFFFFF" Visibility="Collapsed">
            <TextBlock x:Name="HintText"
                       Text="Töltsön fel fényképeket a bal oldalon.&#x0a;Húzza a képet az áthelyezéshez, a sarkokat a méretezéshez."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Georgia"
                       FontSize="16"
                       Foreground="#88665544"
                       TextAlignment="Center"
                       Margin="24"
                       TextWrapping="Wrap" />
        </Border>

        <Canvas x:Name="Surface"
                Background="Transparent"
                ClipToBounds="True"
                SizeChanged="Surface_SizeChanged" />

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="#CCFFFFFF" Padding="10,6">
            <TextBlock Text="Kép / ✥ húzása = mozgatás  •  Sarkok = méret  •  Arány megmarad"
                       FontSize="11"
                       Foreground="#6A655C"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
