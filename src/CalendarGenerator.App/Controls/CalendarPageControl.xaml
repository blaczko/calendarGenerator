<UserControl x:Class="CalendarGenerator.App.Controls.CalendarPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CalendarGenerator.App.Controls"
             Background="Transparent"
             ClipToBounds="True">
    <Grid>
        <!-- Full-page template background -->
        <Border x:Name="PageBackground" />

        <Grid>
            <Grid.RowDefinitions>
                <!-- Slim empty strip for binding / assembly -->
                <RowDefinition x:Name="AssemblyRow" Height="1.2cm" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Assembly area: intentionally empty (no photos, text, or calendar) -->
            <Border Grid.Row="0"
                    Background="#18FFFFFF"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="0,0,0,1" />

            <Grid x:Name="RootGrid" Grid.Row="1" Margin="22,6,22,18" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <!-- Larger photo band; month title overlays the bottom so photos can sit under it -->
                    <RowDefinition Height="1.45*" />
                    <RowDefinition Height="1.0*" />
                </Grid.RowDefinitions>

                <!-- Photo collage (static canvas for PDF, interactive editor for Preview) -->
                <Border x:Name="PhotoSection" Grid.Row="0" CornerRadius="6" ClipToBounds="False">
                    <Grid>
                        <Canvas x:Name="PhotoCanvas" />
                        <local:PhotoCollageEditor x:Name="InteractivePhotos"
                                                  Visibility="Collapsed"
                                                  Background="Transparent" />
                        <Border x:Name="EmptyPhotoHint"
                                Background="#55FFFFFF"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <TextBlock Text="Fényképek"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Georgia"
                                       FontSize="22"
                                       Foreground="#88665544" />
                        </Border>

                        <!-- Month title floats over the photos (bottom); photos may extend underneath -->
                        <StackPanel x:Name="TitleHost"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,10"
                                    IsHitTestVisible="False">
                            <Border x:Name="TitleCard" Background="#CCFFFFFF" CornerRadius="8" Padding="18,6">
                                <StackPanel>
                                    <TextBlock x:Name="MonthTitle"
                                               FontFamily="Georgia"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Foreground="#2C2C2C"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="YearTitle"
                                               FontFamily="Georgia"
                                               FontSize="15"
                                               Foreground="#555555"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Calendar grid + event overlay -->
                <Grid Grid.Row="1" ClipToBounds="False">
                    <Border x:Name="CalendarPanel"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Background="#E6FFFAFA"
                            CornerRadius="6"
                            Padding="1"
                            ClipToBounds="False">
                        <Grid x:Name="CalendarGrid" ClipToBounds="False" />
                    </Border>
                    <Canvas x:Name="EventOverlay"
                            ClipToBounds="False"
                            IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
