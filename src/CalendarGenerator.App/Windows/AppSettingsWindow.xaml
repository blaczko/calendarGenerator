<Window x:Class="CalendarGenerator.App.Windows.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alkalmazás beállítások"
        Height="560"
        Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#F7F1E8"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Mappák" FontFamily="Georgia" FontSize="22" Margin="0,0,0,12" />

                <TextBlock Text="Megrendelések forrásmappája" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Tallózás…" Width="100" Margin="8,0,0,0" Click="BrowseSource_Click" />
                    <TextBox x:Name="SourceFolderBox" />
                </DockPanel>

                <TextBlock Text="PDF kimeneti mappa" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="Tallózás…" Width="100" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                    <TextBox x:Name="OutputFolderBox" />
                </DockPanel>

                <TextBlock Text="Google Drive kapcsolat" FontFamily="Georgia" FontSize="22" Margin="0,0,0,12" />
                <TextBlock TextWrapping="Wrap" Foreground="#6B6258" Margin="0,0,0,12"
                           Text="Hozzon létre OAuth Desktop klienset a Google Cloud Console-ban, majd adja meg a Client ID / Secret értékeket. A gyökérmappa az Apps Script Naptar mappa ID-ja." />

                <TextBlock Text="OAuth Client ID" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="ClientIdBox" Margin="0,0,0,12" />

                <TextBlock Text="OAuth Client Secret" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="ClientSecretBox" Margin="0,0,0,12" />

                <TextBlock Text="Drive gyökérmappa ID (Naptar)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="FolderIdBox" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Kapcsolódás Google Drive-hoz" Click="Connect_Click" Margin="0,0,8,0" Padding="12,8" />
                    <Button Content="Kapcsolat bontása" Click="Disconnect_Click" Padding="12,8" />
                </StackPanel>
                <TextBlock x:Name="DriveStatusText" Foreground="#6B6258" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Mégse" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Mentés" Width="100" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
