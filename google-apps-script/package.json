{
  "name": "naptar-google-apps-script",
  "private": true,
  "version": "1.0.0",
  "description": "Local sync + optional live redeploy for the Naptar Apps Script web app",
  "scripts": {
    "login": "clasp login",
    "doctor": "node scripts/config.mjs doctor",
    "config:sync": "node scripts/config.mjs sync",
    "status": "clasp status",
    "open": "clasp open",
    "pull": "clasp pull",
    "push": "node scripts/config.mjs sync && clasp push",
    "watch": "node scripts/config.mjs sync && clasp push --watch",
    "deploy": "node scripts/deploy.mjs",
    "watch:live": "node scripts/watch-live.mjs",
    "list-deployments": "clasp deployments"
  },
  "devDependencies": {
    "@google/clasp": "^3.1.3",
    "chokidar": "^4.0.3"
  }
}
