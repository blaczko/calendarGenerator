generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  COMPLETED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  publicOrderId      String      @unique
  editTokenHash      String
  editTokenRevoked   Boolean     @default(false)
  fullName           String
  phone              String
  email              String?
  calendarYear       Int
  calendarLanguage   String      @default("hu")
  calendarFormatPref String?
  comments           String?
  privacyConsent     Boolean
  status             OrderStatus @default(NEW)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  photos             Photo[]
  events             CalendarEvent[]
}

model Photo {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  month            Int
  sortOrder        Int
  storedFilename   String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  relativePath     String
  createdAt        DateTime @default(now())

  @@index([orderId, month, sortOrder])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventDate   DateTime
  description String
  createdAt   DateTime @default(now())

  @@index([orderId, eventDate])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
