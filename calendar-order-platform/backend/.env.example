# Local SQLite (relative to backend/)
DATABASE_URL="file:./dev.db"

# HTTP
PORT=4010
CORS_ORIGIN="http://localhost:5174"
PUBLIC_APP_URL="http://localhost:5174"

# Admin (local only — change in production)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme-admin"
ADMIN_SESSION_SECRET="replace-with-long-random-secret"

# Uploads
STORAGE_ROOT="../storage/orders"
MAX_FILE_SIZE_MB=10
# Per month: customers may upload 1–MAX photos (empty months still allowed)
MAX_PHOTOS_PER_MONTH=6
MAX_EVENTS_PER_ORDER=100
SUPPORTED_YEARS="2026,2027,2028,2029"

# Storage adapter: local | google-drive
PHOTO_STORAGE_ADAPTER=local
ORDER_REPOSITORY_ADAPTER=local

# Google (optional — not required for local dev)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_SHEETS_SPREADSHEET_ID=
